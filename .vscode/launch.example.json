{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Django: Run Server",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/manage.py",
            "args": [
                "runserver",
                "--noreload",
                "0:8001"
            ],
            "django": true,
            "env": {
                "DJANGO_SETTINGS_MODULE": "mvj.settings"
            },
            "justMyCode": true
        },
        {
            "name": "Django: Management Command",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/manage.py",
            "args": [
                "${input:managementCommand}"
            ],
            "django": true,
            "env": {
                "DJANGO_SETTINGS_MODULE": "mvj.settings"
            },
            "justMyCode": true
        },
        {
            "name": "Python: Current File",
            "type": "debugpy",
            "request": "launch",
            "program": "${file}",
            "env": {
                "DJANGO_SETTINGS_MODULE": "mvj.settings"
            },
            "justMyCode": true
        }
    ],
    "inputs": [
        {
            "id": "managementCommand",
            "type": "promptString",
            "description": "Management command and arguments (e.g. validate_sanitizerconfig --silent)"
        }
    ]
}
